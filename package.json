{
  "name": "moliya-tracker-backend",
  "version": "1.0.0",
  "description": "Kirim-chiqimlarni kuzatish tizimi - backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node db/init.js",
    "test": "DOTENV_CONFIG_PATH=.env.test NODE_ENV=test node --experimental-vm-modules ./node_modules/.bin/jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "globalSetup": "./tests/global-setup.mjs",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ngrok": "^5.0.0-beta.2",
    "node-telegram-bot-api": "^2.1.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "supertest": "^7.2.2"
  }
}
