# Railway-dagi API service uchun environment namuna
# Bu fayl kod repoda saqlanadi; haqiqiy qiymatlar Railway Variables bo'limida o'rnatiladi.

# PostgreSQL (Railway -> Database -> PostgreSQL dan avtomatik)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Server port (Railway avtomatik beradi)
PORT=3000

# JWT (xavfsiz, iloji boricha uzun random qiymatlar)
JWT_SECRET=change_me_to_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — webapp'ning haqiqiy https URL'lari, vergul bilan ajratiladi.
# Admin Panel (Vercel) origin'i kodda avtomatik qo'shilib keladi.
# CORS_ORIGIN=https://yourapp.up.railway.app

# Telegram
TELEGRAM_BOT_TOKEN=8908421416:AAFFjH86a_1IJ8ukn4f1lx8bJP6RSzjrB6s
TELEGRAM_BOT_ENABLED=true

# AI (Google Gemini) — xohlasangiz backend'da AI buyruq uchun
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_GENERATIVE_AI_API_KEY=change_me

# Veb ilova uchun (webapp)
BOT_TOKEN=8908421416:AAFFjH86a_1IJ8ukn4f1lx8bJP6RSzjrB6s
